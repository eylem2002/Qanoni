# ─────────────────────────────────────────────
# LOCAL DEVELOPMENT — copy this to .env and fill in the values
# ─────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────
# Run locally: brew install postgresql@16 && brew services start postgresql@16
# Then: createdb qanooni_ai
DATABASE_URL=postgresql://localhost:5432/qanooni_ai

# ── Session ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-char-or-longer-string

# ── OpenAI ───────────────────────────────────
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Ports (local dev) ────────────────────────
# Express API server port (used by: artifacts/api-server)
PORT=5001

# Vite dev server port (used by: artifacts/legal-ai)
# Start the frontend with: PORT=5001 VITE_PORT=5173 pnpm --filter @workspace/legal-ai run dev
VITE_PORT=5173

# ── Node environment ─────────────────────────
# Keep as "development" locally. Set to "production" on your server.
NODE_ENV=development

# ── Optional ─────────────────────────────────
# Custom allowed CORS origin for production deployments (e.g. https://qanooni.jo)
# ALLOWED_ORIGIN=https://your-domain.com
